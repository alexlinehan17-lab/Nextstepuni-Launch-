{
  "name": "nextstepuni-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:ci": "eslint .",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/lib/tsc.js --noEmit",
    "typecheck:test": "node --max-old-space-size=4096 ./node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:all": "npm test && npm run test:rules",
    "cap:sync": "npm run build && npx cap sync && npm run cap:prune",
    "cap:ios": "npm run build && npx cap sync ios && npm run cap:prune && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npm run cap:prune && npx cap open android",
    "cap:prune": "node scripts/prune-native-assets.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/app-check": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@rive-app/react-canvas": "^4.34.0",
    "firebase": "^12.8.0",
    "framer-motion": "^12.23.24",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.553.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.1",
    "ts-fsrs": "^5.4.1"
  },
  "overrides": {
    "firebase-tools": {
      "@google-cloud/pubsub": "6.0.1"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "dompurify": "3.4.14",
    "protobufjs": "7.6.5",
    "websocket-driver": "0.7.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "firebase-tools": "^15.28.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.8"
  }
}
