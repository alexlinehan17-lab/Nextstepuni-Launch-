rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requesting user the platform administrator?
    //
    // Keyed on the VERIFIED auth email, never a Firestore field — a document
    // can be written, a token cannot be forged. Moved off admin@nextstep.app
    // on 2026-08-17: that domain has no mailbox, so the password could never
    // be reset and a lost password meant permanent lockout. Must stay in step
    // with utils/adminIdentity.ts and functions/src/adminIdentity.ts.
    function isAdmin() {
      return request.auth != null
             && 'admin' in request.auth.token
             && request.auth.token.admin == true
             && 'email_verified' in request.auth.token
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'nextstepuniinfo@gmail.com'
             && hasActiveSession();
    }

    // Password resets and staff revocations advance this server-owned cutoff
    // on /users/{uid}. Firestore does not consult Auth's refresh-token
    // revocation timestamp, so checking auth_time here closes the otherwise
    // hour-long window in which an already-issued ID token can keep reading.
    // Production Firebase ID tokens always carry an integer auth_time. Missing
    // or malformed auth_time fails closed; the rules test harness supplies it
    // explicitly to match a real token.
    function hasActiveSession() {
      let caller = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let cutoff = 'sessionValidAfterSeconds' in caller ? caller.sessionValidAfterSeconds : 0;
      return request.auth != null
             && 'auth_time' in request.auth.token
             && request.auth.token.auth_time is int
             && request.auth.token.auth_time > cutoff
             && (!('accountDisabled' in caller) || caller.accountDisabled != true);
    }

    // Helper: is the requesting user school staff (guidance counsellor OR
    // teaching staff)? Both have full dashboard parity (owner decision
    // 2026-07-16; compliance/STAFF_DASHBOARD_PLAN.md). `staff` accounts are
    // only ever created by the claimStaffAccess Cloud Function (server-side,
    // per-school code); `role` is client-immutable in the /users update rule,
    // so a client can never self-assign 'gc' or 'staff'.
    function isSchoolStaff() {
      let caller = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return hasActiveSession()
             && 'role' in caller
             && caller.role in ['gc', 'staff']
             && (!('accountDisabled' in caller) || caller.accountDisabled != true);
    }

    // Helper: the requesting staff member's own school.
    function callerSchool() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.school;
    }

    // Journey Points are student-facing motivation, not an authorization
    // credential, but malformed or negative balances still corrupt the shop
    // and staff analytics. Bound every client delta and require spend to stay
    // within lifetime earnings. Cross-user value transfers are callable-only.
    function validPointsMutation() {
      let before = 'pointsData' in resource.data ? resource.data.pointsData : {};
      let after = 'pointsData' in request.resource.data ? request.resource.data.pointsData : {};
      let beforeEarned = 'totalEarned' in before ? before.totalEarned : 0;
      let beforeSpent = 'totalSpent' in before ? before.totalSpent : 0;
      let afterEarned = 'totalEarned' in after ? after.totalEarned : 0;
      let afterSpent = 'totalSpent' in after ? after.totalSpent : 0;
      return afterEarned is int
             && afterSpent is int
             && afterEarned >= beforeEarned
             && afterEarned <= beforeEarned + 500
             && afterSpent >= beforeSpent
             // The largest legitimate landmark purchase is 1,200 JP.
             && afterSpent <= beforeSpent + 1200
             && afterSpent <= afterEarned;
    }

    function validInitialPoints() {
      let after = 'pointsData' in request.resource.data ? request.resource.data.pointsData : {};
      let earned = 'totalEarned' in after ? after.totalEarned : 0;
      let spent = 'totalSpent' in after ? after.totalSpent : 0;
      return earned is int
             && spent is int
             && earned >= 0
             && earned <= 500
             && spent >= 0
             && spent <= earned;
    }

    // Users collection: each user can only read/write their own doc
    match /users/{userId} {
      // Self-read only.
      // Audit 2026-06-01 (high finding): the previous same-school read branch
      // let ANY authenticated student read every same-school student's full
      // users doc — including minors' real names + year group. Peer features
      // now read the /islandPublic projection instead of /users, so no student
      // path needs same-school /users access. GC + admin reads are granted
      // explicitly below (lines for isSchoolStaff()/admin), so the GCDashboard — the
      // only legitimate cross-student consumer — stays authorized.
      allow read: if request.auth != null && request.auth.uid == userId
                  && hasActiveSession();
      // `school` is NOT accepted from the client on create. It is set only by
      // the claimStudentSchool / claimStaffAccess Cloud Functions after the
      // caller proves a valid per-school join / staff code (security review
      // H-2, 2026-07-18). The update rule keeps it immutable thereafter, so a
      // student can never self-assert or switch schools.
      allow create: if request.auth != null && request.auth.uid == userId
                   // Older student records may carry the legacy
                   // `isAdmin: false` field. It has no authorization meaning
                   // (admin access is token-only), so keep those records
                   // usable while still making `true` impossible to create.
                   && (!('isAdmin' in request.resource.data)
                       || request.resource.data.isAdmin == false)
                   && !('role' in request.resource.data)
                   && !('school' in request.resource.data)
                   && !request.resource.data.keys().hasAny([
                     'needsPasswordChange', 'passwordResetAtSeconds',
                     'passwordResetExpiresAtSeconds', 'temporaryPasswordHash',
                     'passwordResetBy', 'sessionValidAfterSeconds',
                     'accountDisabled'
                   ])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 50
                   && request.resource.data.avatar is string
                   && request.resource.data.avatar.size() <= 100;
      // Update: self-write with immutability guarantees on role/school +
      // length validation on name/avatar.
      //
      // BUGFIX 2026-05-23: original rule used `resource.data.role/school`
      // directly. In Firestore CEL, indexed access to a missing map field
      // THROWS rather than returning null, so any merge update on a doc
      // that lacked `role` (e.g. fresh student accounts created via
      // registration) silently failed. Using `.get(field, null)` makes
      // missing-field access safe.
      //
      // BUGFIX 2026-05-23 (round 2): the `name is string` / `avatar is
      // string` checks ALSO threw when those fields were missing from
      // the merge result (e.g. a GC user doc seeded manually via Firebase
      // Console with only role + school). Wrap them in existence checks
      // so updates only validate name/avatar when those fields are
      // actually present in the post-write state.
      allow update: if request.auth != null && request.auth.uid == userId
                   && hasActiveSession()
                   && (!('isAdmin' in request.resource.data)
                       || request.resource.data.isAdmin == false)
                   && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                     'role', 'school', 'isAdmin', 'needsPasswordChange',
                     'passwordResetAtSeconds', 'passwordResetExpiresAtSeconds',
                     'temporaryPasswordHash', 'passwordResetBy',
                     'sessionValidAfterSeconds', 'accountDisabled'
                   ])
                   && (!('name' in request.resource.data)
                       || (request.resource.data.name is string && request.resource.data.name.size() <= 50))
                   && (!('avatar' in request.resource.data)
                       || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 100));
      // Destructive deletion is callable-only so the complete GDPR cascade and
      // audit record cannot be bypassed by deleting individual documents.
      allow read: if isAdmin();
      // School staff can read user docs where school matches their own school.
      allow read: if request.auth != null
                  && isSchoolStaff()
                  && resource.data.school == callerSchool();
    }

    // GC student-flagging: each GC owns gcFlags/{their-uid}/flaggedStudents/*.
    // Audit 2026-06-01 (high finding): this subcollection had no rule and fell
    // through to default-deny, so the flag/note/priority feature was silently
    // non-functional (writes + reads denied, errors swallowed).
    // Path written by hooks/useGCFlags.ts.
    match /gcFlags/{gcUid}/flaggedStudents/{studentUid} {
      allow read, write: if request.auth != null
                  && isSchoolStaff()
                  && gcUid == request.auth.uid;
    }

    // Progress collection: self read + validated writes
    match /progress/{userId} {
      // Self-read
      allow read: if request.auth != null && request.auth.uid == userId
                  && hasActiveSession();
      allow read: if isAdmin();
      // Staff can read progress docs for students in their school. Deletion is
      // callable-only, alongside the matching Auth/user-data cascade.
      allow read: if request.auth != null
                  && isSchoolStaff()
                  && get(/databases/$(database)/documents/users/$(userId)).data.school == callerSchool();
      // Remediation 2026-04-29 (DPIA risk R1): the previous same-school
      // "Peer Islands" peer-read rule on /progress/{userId} was removed.
      // Read access is now restricted to: self, admin, GC of same school.
      // See compliance/REMEDIATION_LOG.md.

      // Create: self only, cap initial points
      allow create: if request.auth != null && request.auth.uid == userId
                   && hasActiveSession()
                   && validInitialPoints();

      // Update: self + field validation on critical gamification fields
      allow update: if request.auth != null && request.auth.uid == userId
        && hasActiveSession()
        && validPointsMutation()
        // Achievements can only be appended, never removed
        && (!('gamification' in resource.data)
            || !('unlockedAchievements' in resource.data.gamification)
            || request.resource.data.gamification.unlockedAchievements
                 .hasAll(resource.data.gamification.unlockedAchievements));

      // Study sessions subcollection. Firestore rules are non-hierarchical, so
      // this must be declared explicitly — otherwise it falls through to the
      // default-deny at the bottom and every session save AND reload is denied,
      // silently breaking the streak/mastery/insights/quests pipeline.
      // (Audit 2026-06-01, blocker B3.)
      match /sessions/{sessionId} {
        // Self read + write
        allow read, write: if request.auth != null && request.auth.uid == userId
                           && hasActiveSession();
        // Admin read (AdminDashboard)
        allow read: if isAdmin();
        // GC of the same school can read (mirrors the parent /progress read above)
        allow read: if request.auth != null
                    && isSchoolStaff()
                    && get(/databases/$(database)/documents/users/$(userId)).data.school == callerSchool();
      }

      // Mark Bank spaced-repetition decks. One document per deck
      // (e.g. biology-higher), holding a map of per-card FSRS memory state.
      // Kept off the parent /progress doc so ~800 cards of review state never
      // inflate app-boot reads for a student who has not opened the tool.
      //
      // As with /sessions above: rules are non-hierarchical, so this block must
      // be declared explicitly. Without it, every review save AND every reload
      // falls through to the default-deny at the bottom and fails SILENTLY —
      // which for a spaced-repetition tool means the student's entire deck
      // appears to reset. This is the same failure mode as audit blocker B3.
      match /srs/{deckId} {
        // Self read + write
        allow read, write: if request.auth != null && request.auth.uid == userId
                           && hasActiveSession();
        // Admin read (AdminDashboard)
        allow read: if isAdmin();
        // GC of the same school can read, so a Guidance Counsellor view can be
        // added later without a rules change (mirrors /progress and /sessions).
        allow read: if request.auth != null
                    && isSchoolStaff()
                    && get(/databases/$(database)/documents/users/$(userId)).data.school == callerSchool();
      }
    }

    // Settings collection: each user can only read/write their own doc
    match /settings/{userId} {
      // Split read/write (audit item 18). Settings hold only small UI prefs.
      allow read: if request.auth != null && request.auth.uid == userId
                  && hasActiveSession();
      allow write: if request.auth != null && request.auth.uid == userId
                   && hasActiveSession();
    }

    // Responses collection: each user can only read/write their own doc
    match /responses/{userId} {
      // Split read/write (audit item 18). Free-text response values are bounded
      // by Firestore's 1MB document cap; a per-field size guard isn't practical
      // given the dynamic { [moduleId]: data } shape.
      allow read: if request.auth != null && request.auth.uid == userId
                  && hasActiveSession();
      allow write: if request.auth != null && request.auth.uid == userId
                   && hasActiveSession();
    }

    // GC Notes (free-text pastoral notes about students) were REMOVED
    // 2026-07-18 (owner decision). The collection has no rules and falls through
    // to the default-deny catch-all. See compliance/evidence/security-review-2026-07.md.

    // GC Settings contain non-secret dashboard preferences only. Access-code
    // material lives in server-only *AccessSecrets collections.
    match /gcSettings/{schoolId} {
      allow read: if request.auth != null && isSchoolStaff() && schoolId == callerSchool();
      allow create: if request.auth != null && isSchoolStaff() && schoolId == callerSchool()
                    && request.resource.data.keys().hasOnly(['dismissedAlerts'])
                    && request.resource.data.dismissedAlerts is map;
      allow update: if request.auth != null && isSchoolStaff() && schoolId == callerSchool()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAlerts'])
                    && request.resource.data.dismissedAlerts is map;
      allow delete: if false;
    }

    // Cohort tags (DEIS / At-risk / Priority) — welfare-sensitive labels about
    // students. Security review 2026-07-16 (M-8): moved off plaintext
    // localStorage into this rules-protected doc, readable/writable only by
    // school staff of that school, and removed by the GDPR erasure cascade.
    match /cohortTags/{schoolId} {
      allow read, write: if request.auth != null
                         && isSchoolStaff()
                         && schoolId == callerSchool();
    }

    // Notifications: self read/write + GC read/write for same-school students
    match /notifications/{userId} {
      // Any user can read/write their own notifications (mark read, auto-notifications)
      allow read, create, update: if request.auth != null
                                 && request.auth.uid == userId
                                 && hasActiveSession();

      // Staff may READ a student's notifications in their own school, but may
      // NOT write them.
      //
      // Security review 2026-08-17: staff previously had create+update here with
      // NO field validation, and the "preset messages only" safeguarding control
      // lived entirely in the student's React bundle, keyed on `type` — a field
      // the sender writes. One setDoc from a staff member's browser console put
      // arbitrary prose in front of a named minor. Rules cannot fix that: the
      // document is a single `items` array and rules cannot iterate arrays.
      //
      // So writes go through the sendStaffNotification callable, which composes
      // every field server-side from a preset id (Admin SDK bypasses rules).
      allow read: if request.auth != null
                  && isSchoolStaff()
                  && get(/databases/$(database)/documents/users/$(userId)).data.school == callerSchool();
    }

    // Kudos collection: peer encouragement notes
    match /kudos/{kudosId} {
      // Recipient can read kudos sent to them
      allow read: if request.auth != null
                  && hasActiveSession()
                  && resource.data.toUid == request.auth.uid;
      // Sender can read kudos they sent (for daily limit check)
      allow read: if request.auth != null
                  && hasActiveSession()
                  && resource.data.fromUid == request.auth.uid;
      // Composed and rate-limited only by sendKudos (Admin SDK).
      allow create, update, delete: if false;
    }

    // Gifts collection: peer island gifts
    match /gifts/{giftId} {
      // Recipient can read their gifts
      allow read: if request.auth != null
                  && hasActiveSession()
                  && resource.data.toUid == request.auth.uid;
      // Sender can read gifts they sent (for daily limit check)
      allow read: if request.auth != null
                  && hasActiveSession()
                  && resource.data.fromUid == request.auth.uid;
      // Created/debited by sendGift and transitioned by placeGift. Clients
      // cannot alter an item's identity, price, recipient or status.
      allow create, update, delete: if false;
    }

    // Teach-backs and SOS Flares (peer free-text sharing) were REMOVED
    // 2026-07-18 as a safeguarding measure — student-authored free text visible
    // to other students created an unacceptable moderation/safeguarding and
    // de-anonymisation surface. The collections (teachbacks, teachbacksPublic,
    // flares and their responses subcollection) now have no rules and therefore
    // fall through to the default-deny catch-all: no client can read or write
    // them. See compliance/evidence/security-review-2026-07.md.

    // GC Events: key dates added by guidance counsellors per school
    match /gcEvents/{schoolId} {
      // GCs can read/write events for their own school
      allow read, write: if request.auth != null
                         && isSchoolStaff()
                         && schoolId == callerSchool();
      // Students can read their school's events (for timetable integration)
      allow read: if request.auth != null
                  && hasActiveSession()
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.school == schoolId;
    }

    // Assignments: revision tasks a GC sets for their school (feature E9).
    // Mirrors the proven gcEvents rule shape exactly: GC read/write for their own
    // school, students read their school's doc. Student COMPLETION is not stored
    // here — students record it in their own /progress doc (self-write, which the
    // GC of the same school can already read), so no student write to this path
    // is needed. Not active in the app until data/assignments.ts ASSIGNMENTS_LIVE
    // is flipped on AND these rules are deployed — see compliance/assignments-plan.md.
    match /assignments/{schoolId} {
      allow read, write: if request.auth != null
                         && isSchoolStaff()
                         && schoolId == callerSchool();
      allow read: if request.auth != null
                  && hasActiveSession()
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.school == schoolId;
    }

    // Island Public: minimal public projection of a student's island
    // (rebuilt 2026-04-29 to replace the same-school read on /progress
    // that was the original R1 exposure — see
    // compliance/PEER_ISLAND_REFACTOR_PLAN.md).
    // Same-school students may read; only Cloud Functions write
    // (Admin SDK bypasses Firestore rules).
    //
    // Rule compares resource.data.school (the queried projection doc's
    // own school field) against the requester's school via a single
    // get() on /users. This shape is required for Firestore queries:
    // a rule that depends on get() of the *target* /users doc cannot
    // be verified against the query's potential result set, so the
    // query is denied even when individual docs would be readable.
    match /islandPublic/{uid} {
      allow read: if request.auth != null
                  && hasActiveSession()
                  && resource.data.school
                     == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.school;
      allow write: if false;
    }

    // The Examiner's Chair — anonymous class cohort of marking blind spots.
    // Keyed by a class code (a shared classroom secret), NOT by school/uid, so
    // a class can span schools/devices. Stores ONLY aggregate counts — no
    // names, no uids — so the collection carries no personal data (anonymous by
    // construction; see compliance/evidence/examiners-chair.md). Any authed
    // user who knows the code may contribute to / read the aggregate; writes
    // are bounded (monotonic, capped increments; students pinned to +1 per
    // submission) to limit tampering, mirroring the teachbacks/flares pattern.
    match /chairCohorts/{classCode} {
      // Parent doc holds only a submissions counter.
      allow read: if request.auth != null && hasActiveSession();
      allow create, update, delete: if false;

      // Moderation Meeting (F5): one counter doc per marking DECISION the class
      // has made on a script — "64% of your class gave this mark" — shown on
      // the reveal so students conference like real SEC markers. Anonymous by
      // construction: identity fields + a single pinned +1 counter, no uids.
      match /decisions/{decisionId} {
        allow read: if request.auth != null && hasActiveSession();
        allow create, update, delete: if false;
      }

      // Daily Mark duel (F9): per class code + UTC day, one counter doc per
      // agreement decile bucket (0–10) — an anonymous histogram the class
      // compares against ("you 9/10, class median 6"). No uids.
      match /daily/{bucketId} {
        allow read: if request.auth != null && hasActiveSession();
        allow create, update, delete: if false;
      }

      // One doc per marking rule the class mis-marks — atomic increments.
      match /rules/{ruleId} {
        allow read: if request.auth != null && hasActiveSession();
        allow create, update, delete: if false;
      }
    }

    // Shared focus presence (F10): "N classmates at their desks right now".
    // Per class code, one counter doc per 5-minute time bucket; each active
    // student increments the current bucket once (client-enforced cadence),
    // so the current bucket's count IS the presence number. No uids, no
    // leave-tracking, nothing per-student — a stale bucket simply ages out.
    match /focusPresence/{classCode}/buckets/{bucketId} {
      allow read: if request.auth != null && hasActiveSession();
      allow create, update, delete: if false;
    }

    // Anonymous product feedback is created only by submitAnonymousFeedback,
    // whose Admin SDK write bypasses these client rules. Feedback documents
    // intentionally contain no uid, name, email or school. Only the platform
    // administrator can read them and move them through the review workflow.
    match /anonymousFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedAt'])
                    && request.resource.data.status in ['new', 'reviewing', 'planned', 'fixed', 'archived']
                    && request.resource.data.reviewedAt is timestamp;
      allow create, delete: if false;
    }

    // Server-only rotating pseudonymous counters. These are deliberately separated
    // from feedback documents and expire after two days.
    match /feedbackRateLimits/{bucketId} {
      allow read, write: if false;
    }

    // First-run funnel counters (utils/funnel.ts). Deliberately carries NO
    // personal data: no uid, name, email or school — only which step was
    // reached, the local day, the platform, and a random per-visit sessionId
    // that exists so one visit's steps can be joined and is not linkable to an
    // account. Append-only: a client may create an event and nothing else, so
    // history cannot be rewritten or mined. Only the administrator reads them.
    match /funnelEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
                    && hasActiveSession()
                    && request.resource.data.keys().hasOnly(['step', 'day', 'at', 'platform', 'sessionId'])
                    && request.resource.data.step is string
                    && request.resource.data.step.size() <= 40
                    && request.resource.data.day is string
                    && request.resource.data.day.size() == 10
                    && request.resource.data.platform in ['web', 'ios', 'android']
                    && request.resource.data.sessionId is string
                    && request.resource.data.sessionId.size() <= 64;
      allow update, delete: if false;
    }

    // Default deny — no other collections are accessible
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
