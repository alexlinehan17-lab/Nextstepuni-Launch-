# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example
!functions/.env.nextstepuni-app
.firebase

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
functions/lib/

# Source exam PDFs (read locally to build verbatim cards; not committed)
exam-papers/
paper-trail-corpus
scripts/paper-trail/out/

__pycache__/
scripts/paper-trail/topic-tags/out/

# PDF workshop build dependencies and rendered QA intermediates.
# Keep the builder, source screenshots, and final output PDFs tracked.
tmp/pdfs/_deps/
tmp/pdfs/deck_pages*/
tmp/pdfs/qa_*/
tmp/pdfs/rendered_*/

# transient topic-tag pipeline scratch (root)
/_*.json
/_*.mjs

# Android release signing — the upload key and its passwords. Never commit these.
# Losing the keystore is recoverable (Play App Signing lets you reset an upload
# key) but leaking it is not, so it stays out of the repo entirely.
android/keystore.properties
*.jks
*.keystore

# Exam papers and scheme PDFs live in the Paper Trail corpus in Firebase
# Storage, which is where the app itself reads them from. Fetch them with
# scripts/markbank/fetch-corpus.py rather than committing ~120 MB of PDFs that
# already have a canonical home. (Agricultural Science and Economics papers
# predate this and stay tracked; gitignore does not untrack them.)
examiner-reports/*/papers/*.pdf
examiner-reports/*/schemes/*.pdf
examiner-reports/*/supplements/
# Arabic keeps a SECOND corpus, wider than the window it cards, because its
# broken-font repair map is derived from every sitting the Paper Trail holds
# and not only from the ten the bank counts (see authoring/ARABIC.md). Same
# canonical home, same reason not to commit it; the derived map,
# authoring/glyphmap-arabic.json, is what is tracked.
examiner-reports/*/glyph-corpus/

# Landing-page reference recordings (44–414 MB each; GitHub rejects files over 100 MB).
# They stay on the founder's Mac; the contact sheets and notes in design-references/landing/ are what is tracked.
design-references/landing/*.mov

# Figure crops rendered for review by <subject>_figures.py --write. The
# published crops live under exam-papers/<subject>/figures/ and are bound
# through the manifest; these are working renders, regenerable on demand.
figures-review*/
